<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputPath>..\Binary</OutputPath>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<Title>LoremPress</Title>
		<Authors>Stanislav Koncebovski, Francesca Yffelti</Authors>
		<Company>pikkatech.eu</Company>
		<Description>Lightweight symbolic lorem-like generator of random titles, journals and other entities</Description>
		<PackageProjectUrl>https://github.com/pikkatech-eu/LoremPress</PackageProjectUrl>
		<RepositoryUrl>https://github.com/pikkatech-eu/LoremPress</RepositoryUrl>
		<PackageTags>lorem,text,generator,fake-data</PackageTags>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageIcon>LoremPress_04.png</PackageIcon>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CS0168;CS0414;CS8600;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CS8629;CS8714;IDE0028;IDE0090</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CS0168;CS0414;CS8600;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CS8629;CS8714;IDE0028;IDE0090</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\..\..\Users\Stanislav\Desktop\LoremPress_04.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
